{
  "config": {
    "step": {
      "user": {
        "title": "TOKIT induction cooker",
        "description": "Talks to the cooker directly on your network. Nothing goes through TOKIT's or Xiaomi's servers.",
        "data": {
          "host": "IP address",
          "token": "Token"
        },
        "data_description": {
          "host": "Give the cooker a fixed address in your router so this doesn't change.",
          "token": "32 characters, using only 0-9 and a-f. It changes whenever the cooker's Wi-Fi is set up again."
        }
      }
    },
    "error": {
      "cannot_connect": "No answer from the cooker. Check the address and the token.",
